# ==============================================================================
# DataNexus v2.0.0 Platform — Production Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# Note: Sensitive credentials must NEVER be committed to version control.
# ==============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=datanexus_dev_secret_key_change_in_production

# Storage Settings
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=25

# Storage Backend ('local' or 's3')
STORAGE_BACKEND=local
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY=3600

# Database Configuration
# Local development default: zero-dependency SQLite
DATABASE_URL=sqlite:///./datanexus.db
# Production / Docker PostgreSQL connection:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datanexus

# Elasticsearch Settings (Optional at runtime; fallback to local vector search if offline)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=datanexus_documents
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_TIMEOUT_SECONDS=1.0

# Background Processing & Cache
# Supported brokers: 'database' (built-in durable queue), 'memory', or 'redis'
QUEUE_BROKER=database
REDIS_URL=redis://localhost:6379/0

# Cross-Encoder Reranker (FlashRank ONNX)
RERANKER_ENABLED=true
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANKER_CACHE_DIR=

# OpenTelemetry (OTel) Distributed Tracing
OTEL_ENABLED=false
OTEL_SERVICE_NAME=datanexus
OTEL_EXPORTER_OTLP_ENDPOINT=

# Embedding Provider
# Options: 'sentence_transformers' (all-MiniLM-L6-v2), 'local_dense', or 'gemini'
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REPRESENTATION_VERSION=2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Pluggable AI / LLM Configuration (For Retrieval-Augmented Question Answering)
# Primary: GroqCloud (Ultra-low latency inference: qwen/qwen3.8-27b, llama-3.3-70b-versatile, etc.)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=800
GROQ_TIMEOUT_SECONDS=15.0

# Optional / Secondary Providers
GEMINI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b

# Security & API Key Authentication (Optional in development, strict in production)
API_KEY_ENABLED=false
API_KEY=datanexus_dev_api_key_2026

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:5174
