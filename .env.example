# ==============================================================================
# DataNexus Platform — Environment Configuration Template
# Copy this file to '.env' and adjust values for your local environment.
# Note: Sensitive credentials must NEVER be committed to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=datanexus_dev_secret_key_change_in_production

# Storage Settings
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=25

# Database Configuration
# Local development default: zero-dependency SQLite
DATABASE_URL=sqlite:///./datanexus.db
# Production / Docker PostgreSQL connection (planned integration):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datanexus

# Elasticsearch Settings (Optional at runtime; fallback to local vector search if offline)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=datanexus_documents
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Background Processing & Queue
# Supported brokers: 'database' (built-in durable queue), 'memory', or 'redis'
QUEUE_BROKER=database
REDIS_URL=redis://localhost:6379/0

# Embedding Provider
# Options: 'sentence_transformers' (pretrained neural embeddings: sentence-transformers/all-MiniLM-L6-v2), 'local_dense' (interim lexical hashing baseline), or 'gemini'
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_REPRESENTATION_VERSION=2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Pluggable AI / LLM Configuration (For Retrieval-Augmented Question Answering)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Frontend Development Server & CORS Origin
FRONTEND_URL=http://localhost:5173
