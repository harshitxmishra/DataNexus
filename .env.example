# DataNexus Platform Environment Configuration

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=datanexus_dev_secret_key_change_in_production

# Storage Settings
STORAGE_DIR=./data/storage
MAX_UPLOAD_SIZE_MB=25

# Database Settings
# For local Windows development without Docker, SQLite is supported out of the box:
DATABASE_URL=sqlite:///./datanexus.db
# For PostgreSQL (production or Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datanexus

# Elasticsearch Settings (Optional at runtime, required for distributed hybrid search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=datanexus_documents
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Background Processing & Queue
# Set to 'memory' or 'database' for built-in durable DB queue, or 'redis' when redis is available
QUEUE_BROKER=database
REDIS_URL=redis://localhost:6379/0

# Embedding Provider (local_tfidf, local_dense, or gemini)
EMBEDDING_PROVIDER=local_dense
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Pluggable AI / LLM Configuration (for document question-answering)
GEMINI_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
