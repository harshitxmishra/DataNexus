# ============================================================
# DataNexus — Docker Compose Environment Configuration
# ============================================================

# Database (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datanexus
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/datanexus

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=datanexus_chunks
SEARCH_PROVIDER=auto

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# GroqCloud LLM (Optional - will gracefully fallback to extractive synthesis if empty)
GROQ_API_KEY=
GROQ_PRIMARY_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
